    "mono": {
      "$extensions": {
        "com.figma.scopes": [],
        "com.figma.hiddenFromPublishing": true
      },
      "$type": "text",
      "$value": "Roboto Mono",
      "$description": "Monospace typeface for numeric and tabular type. Locked — one value across every brand, script and viewport; numeric type is not a brand differentiator.\n\nUsed in:\nThe .numeric variants of body and label — tables, prices, timestamps, anywhere digits align.\n\nDo not:\nDo not use it for prose or labels — those take font-family.text; mono is for aligned digits only."
