{
  "font-size": {
    "base": {
      "$extensions": {
        "com.figma.scopes": [],
        "com.figma.hiddenFromPublishing": true
      },
      "$type": "number",
      "$value": "16",
      "$description": "The default base font size: the md step the Ignite Brand Generator proposes for a new brand, and the root font-size the consuming app sets in its CSS so rem values resolve against it."
    },
    "ratio": {
      "major-second": {
        "$extensions": {
          "com.figma.scopes": [],
          "com.figma.hiddenFromPublishing": true
        },
        "$type": "number",
        "$value": 1.125,
        "$description": "Major second (9:8): a compact hierarchy, steps close together for dense screens."
      },
      "minor-third": {
        "$extensions": {
          "com.figma.scopes": [],
          "com.figma.hiddenFromPublishing": true
        },
        "$type": "number",
        "$value": 1.2,
        "$description": "Minor third (6:5): a balanced hierarchy, each level clearly larger than the next without oversized jumps."
      },
      "perfect-fourth": {
        "$extensions": {
          "com.figma.scopes": [],
          "com.figma.hiddenFromPublishing": true
        },
        "$type": "number",
        "$value": 1.333,
        "$description": "Perfect fourth (4:3): a strong hierarchy, each level about a third larger, for expressive headlines."
      }
    }
  },
