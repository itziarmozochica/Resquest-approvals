          "letterSpacing": {
            "custom": true,
            "presets": {
              "display": "wide",
              "heading": "tight",
              "body": "normal",
              "label": "normal",
              "caption": "normal",
              "micro": "normal",
              "micro-caps": "wide"
            }
          },
          "color": {
            "primary": "3BB8BA",
            "customAccent": true,
            "accent": "3BB8BA"
          },
          "radius": {
            "preset": "sharp",
            "fineTune": true,
            "overrides": {
              "button": {
                "sm": "4",
                "md": "4",
                "lg": "4"
              },
              "input": {
                "sm": "4",
                "md": "4",
                "lg": "4"
              },
              "container": {
                "xs": "4",
                "sm": "4",
                "md": "4",
                "lg": "4",
                "xl": "4",
                "2xl": "4"
              }
            },
            "edits": {
              "balanced": {
                "button": {
                  "sm": "full",
                  "md": "full",
                  "lg": "full"
                },
                "input": {},
                "container": {}
              },
              "sharp": {
                "button": {
                  "sm": "4",
                  "md": "4",
                  "lg": "4"
                },
                "input": {
                  "sm": "4",
                  "md": "4",
                  "lg": "4"
                },
                "container": {
                  "xs": "4",
                  "sm": "4",
                  "md": "4",
                  "2xl": "4",
                  "xl": "4",
                  "lg": "4"
                }
              }
            }
          },
          "borderWidth": {
            "xs": "0-5",
            "sm": "1",
            "md": "2",
            "lg": "4"
          }
        }
      },
      "$type": "fontSizes",
      "$value": 16
