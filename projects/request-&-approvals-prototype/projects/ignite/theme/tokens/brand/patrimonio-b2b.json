    "md": {
      "$extensions": {
        "com.figma.hiddenFromPublishing": true,
        "com.fever.ignite-brand-generator": {
          "version": 2,
          "ratio": "major-second",
          "basePx": 16,
          "skips": {
            "4xl": 1
          },
          "lineHeight": {
            "custom": true,
            "presets": {
              "display": "tight",
              "heading": "tight",
              "body": "relaxed"
            }
          },
          "letterSpacing": {
            "custom": true,
            "presets": {
              "display": "wide",
              "heading": "tight",
              "body": "normal",
              "label": "wide",
              "caption": "normal",
              "micro": "normal",
              "micro-caps": "wide"
            }
          },
          "color": {
            "primary": "E81A00",
            "customAccent": true,
            "accent": "A78E53"
          },
          "radius": {
            "preset": "sharp",
            "fineTune": true,
            "overrides": {
              "button": {
                "sm": "0",
                "md": "0",
                "lg": "0"
              },
              "input": {
                "sm": "0",
                "md": "0",
                "lg": "0"
              },
              "container": {
                "xs": "0",
                "sm": "0",
                "md": "0",
                "lg": "0",
                "xl": "0",
                "2xl": "0"
              }
            },
            "edits": {
              "balanced": {
                "button": {
                  "sm": "full",
                  "md": "full",
                  "lg": "full"
                },
                "input": {},
                "container": {}
              }
            }
          },
          "borderWidth": {
            "xs": "0-5",
            "sm": "1",
            "md": "2",
            "lg": "4"
          },
          "button": {
            "primaryStep": "600"
          }
        }
      },
      "$type": "fontSizes",
      "$value": 16
    },
    "lg": {
