  "button": {
    "color-surface": {
      "primary": {
        "default": {
          "$extensions": {
            "com.figma.scopes": [
              "FRAME_FILL"
            ],
            "com.figma.hiddenFromPublishing": false,
            "com.figma.codeSyntax": {
              "WEB": "var(--fv-button-color-surface-primary-default)"
            }
          },
          "$type": "color",
          "$value": "{color.primary.550}",
          "$description": "Fill of the brand primary button at rest. Varies by brand; by default it follows color-surface.interactive.brand.strong.default, and with it the theme. A brand that overrides it with a ramp step or a fixed colour keeps that value in both themes.\n\nUsed in:\nThe primary button of the brand sentiment, at rest. Pair with button.color-content.primary for its label and icons, and with button.color-surface.primary.hover for its pointer-over state.\n\nDo not:\nDo not use it outside that button — a checkbox, a radio, a danger or neutral primary button or any other solid fill takes its color-surface.interactive.<sentiment>.strong.default."
        },
        "hover": {
          "$extensions": {
            "com.figma.scopes": [
              "FRAME_FILL"
            ],
            "com.figma.hiddenFromPublishing": false,
            "com.figma.codeSyntax": {
              "WEB": "var(--fv-button-color-surface-primary-hover)"
            }
          },
          "$type": "color",
          "$value": "{color.primary.600}",
          "$description": "Fill of the brand primary button under the pointer. Varies by brand; by default it follows color-surface.interactive.brand.strong.hover, and with it the theme. A brand that overrides it with a ramp step or a fixed colour keeps that value in both themes.\n\nUsed in:\nThe pointer-over state of the primary button of the brand sentiment. Pair with button.color-surface.primary.default at rest and with button.color-content.primary.\n\nDo not:\nDo not use it on any other solid hover — that is color-surface.interactive.brand.strong.hover."
        }
      }
    },
    "color-content": {
      "primary": {
        "$extensions": {
          "com.figma.scopes": [
            "SHAPE_FILL",
            "TEXT_FILL"
          ],
          "com.figma.hiddenFromPublishing": false,
          "com.figma.codeSyntax": {
            "WEB": "var(--fv-button-color-content-primary)"
          }
        },
        "$type": "color",
        "$value": "{color-content.static.fixed-white}",
        "$description": "Label and icons on the brand primary button. Varies by brand; by default it follows color-content.static.fixed-white, which keeps 4.5:1 against both default fills in light and dark.\n\nUsed in:\nThe label and icons of the primary button of the brand sentiment. Pair with button.color-surface.primary.default and button.color-surface.primary.hover.\n\nDo not:\nDo not use it on any other strong fill — content on a sentiment strong fill is color-content.static.fixed-white."
      }
    }
  }
