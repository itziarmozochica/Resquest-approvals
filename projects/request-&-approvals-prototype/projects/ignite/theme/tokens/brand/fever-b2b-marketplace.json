    "md": {
      "$extensions": {
        "com.figma.hiddenFromPublishing": true,
        "com.fever.ignite-brand-generator": {
          "version": 2,
          "ratio": "major-second",
          "basePx": 16,
          "skips": {
            "4xl": 1
          },
          "lineHeight": {
            "custom": true,
            "presets": {
              "display": "tight",
              "heading": "tight",
              "body": "relaxed"
            }
          },
          "letterSpacing": {
            "custom": true,
            "presets": {
              "display": "wide",
              "heading": "tight",
              "body": "normal",
              "label": "normal",
              "caption": "normal",
              "micro": "normal",
              "micro-caps": "wide"
            }
          },
          "color": {
            "primary": "6A63E9",
            "customAccent": true,
            "accent": "D4FF3A"
          },
          "radius": {
            "preset": "balanced",
            "fineTune": true,
            "overrides": {
              "button": {
                "sm": "8",
                "md": "8",
                "lg": "8"
              },
              "input": {
                "sm": "8",
                "md": "8",
                "lg": "12"
              },
              "container": {
                "xs": "4",
                "sm": "8",
                "md": "8",
                "lg": "12",
                "xl": "16",
                "2xl": "24"
              }
            },
            "edits": {
              "balanced": {
                "button": {
                  "lg": "8"
                },
                "input": {},
                "container": {
                  "xs": "4",
                  "sm": "8"
                }
              }
            }
          },
          "borderWidth": {
            "xs": "0-5",
            "sm": "1",
            "md": "2",
            "lg": "4"
          },
          "button": {
            "primaryStep": "550"
          }
        }
      },
      "$type": "fontSizes",
      "$value": 16
