{
  "name": "ignite",
  "version": "0.0.0",
  "description": "Fever design system library (Ignite). Not published; consumed by workspace apps.",
  "private": true,
  "scripts": {
    "lint:ts": "ng lint",
    "lint:ts:ci": "ng lint --c ci",
    "lint:ts:diff": "lint-diff",
    "lint:debt:diff": "lint-debt",
    "lint:styles": "stylelint './**/*.scss' --quiet",
    "lint:styles:ci": "stylelint './**/*.scss'",
    "lint:styles:diff": "stylelint-diff",
    "test": "jest --config jest.config.mjs",
    "test:ci": "jest --ci --config jest.config.mjs",
    "tokens:build": "node theme/scripts/build-tokens.mjs --platforms=web",
    "test:scripts": "node --test theme/scripts/*.test.mjs"
  },
  "devDependencies": {
    "@figma/code-connect": "^1.4.9",
    "@tokens-studio/sd-transforms": "^2.0.3",
    "style-dictionary": "^5.6.0",
    "workspace-lint": "workspace:*",
    "workspace-scripts": "workspace:*"
  },
  "sideEffects": false
}
