{
  "$schema": "../../node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "bank-account": {
      "projectType": "library",
      "root": ".",
      "sourceRoot": "src",
      "prefix": "bank-account",
      "architect": {
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["**/*.{ts,mjs,html}"],
            "eslintConfig": "eslint.config.mjs",
            "quiet": true
          },
          "configurations": {
            "ci": {
              "quiet": false,
              "format": "../workspace-lint/formatters/eslint-formatter.mjs"
            }
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
