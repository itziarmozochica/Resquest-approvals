{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "schematics": {
    "@schematics/angular:component": {
      "changeDetection": "OnPush",
      "skipImport": true,
      "standalone": true,
      "style": "scss",
      "flat": false
    },
    "@schematics/angular:directive": {
      "skipImport": true,
      "standalone": true,
      "flat": false
    },
    "@schematics/angular:service": {
      "flat": false
    }
  },
  "projects": {
    "feverzoneclient": {
      "root": "",
      "sourceRoot": "src",
      "projectType": "application",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist",
            "index": "src/index/local/index.html",
            "browser": "src/main.ts",
            "polyfills": ["src/polyfills.ts", "@angular/localize/init"],
            "tsConfig": "src/tsconfig.app.json",
            "assets": [
              "src/favicon.ico",
              "src/assets",
              "src/manifest.json",
              {
                "glob": "pdfmake.min.js",
                "input": "node_modules/pdfmake/build",
                "output": "assets/pdfmake"
              },
              {
                "glob": "vfs_fonts.js",
                "input": "node_modules/pdfmake/build",
                "output": "assets/pdfmake"
              },
              {
                "glob": "pdf.worker.min.mjs",
                "input": "node_modules/pdfjs-dist/legacy/build",
                "output": "assets/pdfjs"
              },
              {
                "glob": "data.json",
                "input": "node_modules/emoji-picker-element-data/en/emojibase",
                "output": "assets/ignite/emoji-picker"
              }
            ],
            "styles": [
              "projects/ignite/theme/dist/web/brands/feverzone-legacy.css",
              "projects/ignite/theme/src/ignt-base.scss",
              "src/styles.scss",
              { "input": "src/theme/brands/caixa-b2b.scss", "bundleName": "brand-caixa-b2b", "inject": false },
              { "input": "projects/ignite/theme/dist/web/brands/onebox-b2b.css", "bundleName": "brand-onebox-b2b", "inject": false },
              { "input": "src/theme/brands/patrimonio-b2b.scss", "bundleName": "brand-patrimonio-b2b", "inject": false }
            ],
            "stylePreprocessorOptions": {
              "includePaths": ["src/theme", "projects/ignite/theme/src"]
            },
            "allowedCommonJsDependencies": [
              "@fortawesome/free-brands-svg-icons/faFacebookF",
              "@fortawesome/free-brands-svg-icons/faFacebookMessenger",
              "@fortawesome/free-brands-svg-icons/faTwitter",
              "@fortawesome/free-brands-svg-icons/faWhatsapp",
              "@fortawesome/pro-light-svg-icons/faCopy",
              "@fortawesome/pro-light-svg-icons/faEnvelope",
              "autonumeric",
              "file-saver",
              "iframe-resizer",
              "json-schema",
              "localforage",
              "murmurhash",
              "pdfmake/build/pdfmake.min",
              "pdfmake/build/vfs_fonts",
              "qrcode",
              "ua-parser-js"
            ],
            "scripts": [],
            "extractLicenses": false,
            "sourceMap": true,
            "optimization": false,
            "serviceWorker": "ngsw-config.json"
          },
          "configurations": {
            "runtime": {
              "browser": "src/main.runtime.ts",
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.runtime.ts"
                }
              ],
              "index": "src/index/runtime/index.html",
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": true
              },
              "outputHashing": "all",
              "sourceMap": {
                "scripts": true,
                "styles": true,
                "hidden": true
              },
              "extractLicenses": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "5mb",
                  "maximumError": "8.8mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "200kB"
                }
              ]
            },
            "runtime-unoptimized": {
              "browser": "src/main.runtime.ts",
              "budgets": [],
              "extractLicenses": false,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.runtime.ts"
                }
              ],
              "index": "src/index/runtime/index.html",
              "namedChunks": false,
              "optimization": false,
              "outputHashing": "none",
              "sourceMap": false
            },
            "runtime-e2e": {
              "browser": "src/main.runtime.ts",
              "budgets": [],
              "define": {
                "ngDevMode": "false"
              },
              "extractLicenses": false,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.runtime.ts"
                }
              ],
              "index": "src/index/runtime/index.html",
              "namedChunks": false,
              "optimization": false,
              "outputHashing": "none",
              "sourceMap": false
            },
            "development": {
              "budgets": [
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "200kB"
                }
              ]
            },
            "localStaging": {
              "budgets": [
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "200kB"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.local-staging.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "runtime"
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["src/**/*.{ts,mjs,html,js}"],
            "eslintConfig": "eslint.config.mjs",
            "quiet": true
          },
          "configurations": {
            "ci": {
              "quiet": false,
              "format": "./projects/workspace-lint/formatters/eslint-formatter.mjs"
            }
          }
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "proxyConfig": "proxy.conf.json",
            "port": 5200,
            "host": "127.0.0.1",
            "buildTarget": "feverzoneclient:build"
          },
          "configurations": {
            "development": {
              "proxyConfig": "proxy.local.json",
              "buildTarget": "feverzoneclient:build:development"
            },
            "localProd": {
              "host": "localhost",
              "proxyConfig": "proxy.prod.json",
              "buildTarget": "feverzoneclient:build:development"
            },
            "localGuard": {
              "proxyConfig": "proxy.guard.json",
              "buildTarget": "feverzoneclient:build:development"
            },
            "localStaging": {
              "proxyConfig": "proxy.conf.json",
              "host": "localhost",
              "buildTarget": "feverzoneclient:build:localStaging"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "feverzoneclient:build"
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
