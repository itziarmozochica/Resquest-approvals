{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cp .npmrc.example .npmrc && corepack enable && pnpm install --no-frozen-lockfile",
  "buildCommand": "pnpm exec ng build --configuration localStaging --optimization --source-map=false",
  "outputDirectory": "dist/browser",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
