{
  "tabWidth": 2,
  "singleQuote": true,
  "printWidth": 140,
  "arrowParens": "avoid",
  "plugins": ["@ianvs/prettier-plugin-sort-imports"],
  "importOrder": [
    "^(@angular)", "",
    "<THIRD_PARTY_MODULES>",
    "",
    "^(@feverup)",
    "", "^((\\.+/)|(~/))"
  ],
  "importOrderParserPlugins": ["typescript", "decorators-legacy"]
}
