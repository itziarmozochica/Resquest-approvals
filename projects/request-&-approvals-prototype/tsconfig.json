{
  "extends": "./tsconfig.pre-strict.json",
  "include": [
    "src/**/*.ts",
    "projects/fz-kiosk/**/*.ts",
    "projects/fz-original/**/*.ts",
    "projects/fz-shop-products/**/*.ts",
    "projects/fz-control-panel/**/*.ts",
    "projects/fz-tracking/**/*.ts",
    "projects/fz-guestlists/**/*.ts",
    "projects/fz-ads-manager/**/*.ts",
    "projects/fz-reporting/**/*.ts",
    "projects/fz-pricing-experiments/**/*.ts",
    "projects/fz-crm-campaigns/**/*.ts",
    "projects/fz-pricing-intelligence/**/*.ts",
    "projects/product-marketing/**/*.ts",
    "projects/@fz/utils/**/*.ts",
    "projects/@fz/http-models/**/*.ts",
    "projects/@fz/storage/**/*.ts",
    "projects/@fz/version-check/**/*.ts",
    "projects/b2b-iam/**/*.ts",
    "projects/bank-account/**/*.ts",
    "projects/channel/**/*.ts",
    "projects/cloudinary-media/**/*.ts",
    "projects/invoicing/**/*.ts",
    "projects/ticketing/**/*.ts",
    "projects/fz-ticketing-ui/**/*.ts",
    "projects/reservations/**/*.ts",
    "projects/ignite-storybook/**/*.ts",
    "projects/b2b-marketplace/**/*.ts"
  ],
  "angularCompilerOptions": {
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  },
  "compilerOptions": {
    "skipLibCheck": true,
    "strict": true,
    "plugins": [{ "name": "@angular/language-service" }]
  }
}
