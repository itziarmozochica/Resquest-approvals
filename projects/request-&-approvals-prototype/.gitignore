# See http://help.github.com/ignore-files/ for more about ignoring files.

# compiled output
/tmp
/out-tsc
# Only exists if Bazel was run
/bazel-out
/junit.xml

# dependencies
node_modules

# profiling files
chrome-profiler-events.json
speed-measure-plugin.json

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/extensions.json
.history/*

# Angular
.angular
dist
dist-e2e

# Reports
**/.reports/*
!**/.reports/lint/
**/.reports/lint/*
!**/.reports/lint/.gitkeep

# misc
.local/
.pnpm-store/
.turbo
/.sass-cache
/connect.lock
/coverage
projects/*/coverage
/libpeerconnection.log
npm-debug.log
pnpm-debug.log
yarn-error.log
testem.log
/typings
.npmrc
.eslintcache

# System Files
.DS_Store
Thumbs.db
junit.xml

*storybook.log

# Playwright
.report
test-results
.report-prod-e2e

# Jest JUnit reports
.jest-junit

# Jest spec selection on pull requests (scripts/jest-select-specs.mjs)
.jest-selection.json
.jest-packages.json

# Playwright spec selection on pull requests (scripts/playwright-select-specs.mjs)
.playwright-selection.json
.playwright-spec-map.json

# Playwright stress check on pull requests (scripts/playwright-stress-gate.mjs)
.playwright-stress.json
.playwright-stress-durations.json

# FZ Kiosk
projects/fz-kiosk/src/assets/*
!/projects/fz-kiosk/src/assets/.gitkeep
projects/fz-kiosk/src/dev-config.mjs

# CompoDoc JSON (Storybook ignite-storybook; see angular.json compodoc -d)
projects/ignite-storybook/.compodoc/documentation.json

# check-strict bypass marker (see scripts/check-strict.mjs)
.check-strict-skipped

# Agent harness: the shared config is tracked, personal overrides are not
.claude/settings.local.json

# The design-token pipeline commits its output (B2BP-1554): exempt it from the dist rule above
!projects/ignite/theme/dist/
