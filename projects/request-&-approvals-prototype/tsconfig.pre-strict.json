{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": "./",
    "downlevelIteration": true,
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "module": "esnext",
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "lib": ["es2018", "dom"],
    "useDefineForClassFields": false,
    "paths": {
      "@fz-original/*": ["src/*"],
      "@fz-kiosk/*": ["projects/fz-kiosk/src/app/*"],
      "@fz-kiosk-playwright/*": ["projects/fz-kiosk/playwright/*"],
      "@fz-original-playwright/*": ["projects/fz-original/playwright/*"],
      "@fz-shop-products/*": ["projects/fz-shop-products/*"],
      "@fz-control-panel/*": ["projects/fz-control-panel/*"],
      "@fz/fz-tracking/*": ["projects/fz-tracking/*"],
      "@fz-guestlists/*": ["projects/fz-guestlists/*"],
      "@fz-ads-manager/*": ["projects/fz-ads-manager/*"],
      "@fz-reporting/*": ["projects/fz-reporting/*"],
      "@fz-pricing-experiments/*": ["projects/fz-pricing-experiments/*"],
      "@fz-crm-campaigns/*": ["projects/fz-crm-campaigns/*"],
      "@fz-pricing-intelligence/*": ["projects/fz-pricing-intelligence/*"],
      "@fz/libs/ignite-declarations/...": ["projects/@fz/ignite-declarations/..."],
      "@fz/libs/ignite-styles/...": ["projects/@fz/ignite-styles/..."],
      "@fz/libs/business/...": ["projects/@fz/business/..."],
      "@ignite/legacy/*": ["projects/ignite/legacy/src/*"],
      "@ignite/common": ["projects/ignite/common/src/public-api.ts"],
      "@ignite/common/testing": ["projects/ignite/common/testing/public-api.ts"],
      "@ignite/icon": ["projects/ignite/icon/src/public-api.ts"],
      "@ignite/charts": ["projects/ignite/charts/src/public-api.ts"],
      "@ignite/table": ["projects/ignite/table/src/public-api.ts"],
      "@ignite/rich-text-editor": ["projects/ignite/rich-text-editor/src/public-api.ts"],
      "@fz/utils/*": ["projects/@fz/utils/*"],
      "@fz/http-models": ["projects/@fz/http-models/index.ts"],
      "product-marketing": ["projects/product-marketing/src/public-api.ts"],
      "@fz/storage": ["projects/@fz/storage/index.ts"],
      "@fz/version-check": ["projects/@fz/version-check/src/public-api.ts"],
      "@fz/b2b-iam": ["projects/b2b-iam/src/public-api.ts"],
      "@fz/channel": ["projects/channel/src/public-api.ts"],
      "@fz/invoicing": ["projects/invoicing/src/public-api.ts"],
      "@fz/ticketing": ["projects/ticketing/src/public-api.ts"],
      "@fz/ticketing-ui": ["projects/fz-ticketing-ui/src/public-api.ts"],
      "@fz/bank-account": ["projects/bank-account/src/public-api.ts"],
      "@fz/bank-account/currency": ["projects/bank-account/src/currency-api.ts"],
      "@fz/cloudinary-media": ["projects/cloudinary-media/src/public-api.ts"],
      "@fz/reservations": ["projects/reservations/src/public-api.ts"],
      "@b2b-marketplace/*": ["projects/b2b-marketplace/src/app/*"],
      "@optimizely/optimizely-sdk/dist/shared_types": ["node_modules/@optimizely/optimizely-sdk/dist/shared_types.d.ts"]
    },
    "noImplicitAny": true
  }
}
